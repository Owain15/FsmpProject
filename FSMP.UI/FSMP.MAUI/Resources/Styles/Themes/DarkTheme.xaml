<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FSMP.MAUI.Resources.Styles.Themes.DarkTheme">

    <Color x:Key="ThemeBackground">#121212</Color>
    <Color x:Key="ThemeText">#FFFFFF</Color>
    <Color x:Key="ThemePrimary">#E53935</Color>
    <Color x:Key="ThemeSecondary">#1E1E2E</Color>
