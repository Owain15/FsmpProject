<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FSMP.MAUI.Components.TopNavBar">
    <VerticalStackLayout Spacing="0" BackgroundColor="{DynamicResource ThemeSurface}">
        <!-- Row 1: Title + hamburger -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,12,16,8">
            <!-- Hamburger button (compact mode only) -->
            <Button x:Name="HamburgerBtn"
                    Text="☰" FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource ThemeText}"
                    Padding="8,4" MinimumWidthRequest="44"
                    Clicked="OnHamburgerClicked"
                    IsVisible="False"
                    Grid.Column="0" />

            <!-- Page title -->
            <Label x:Name="PageTitleLabel"
                   Text="Now Playing"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeText}"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Grid.Column="1" />
        </Grid>

        <!-- Row 2: Nav tabs with underline indicator -->
        <HorizontalStackLayout x:Name="NavButtonRow" Spacing="0" Padding="12,0,12,4">
            <!-- Now Playing tab -->
            <VerticalStackLayout Spacing="0">
                <Label x:Name="NavNowPlaying" Text="Now Playing" FontSize="14"
                       TextColor="{DynamicResource ThemeText}" Padding="14,8"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTabTapped" CommandParameter="NowPlaying" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView x:Name="IndicatorNowPlaying" HeightRequest="3" Color="Transparent"
                         HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <!-- Library tab -->
            <VerticalStackLayout Spacing="0">
                <Label x:Name="NavLibrary" Text="Library" FontSize="14"
                       TextColor="{DynamicResource ThemeText}" Padding="14,8"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTabTapped" CommandParameter="Library" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView x:Name="IndicatorLibrary" HeightRequest="3" Color="Transparent"
                         HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <!-- Playlists tab -->
            <VerticalStackLayout Spacing="0">
                <Label x:Name="NavPlaylists" Text="Playlists" FontSize="14"
                       TextColor="{DynamicResource ThemeText}" Padding="14,8"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTabTapped" CommandParameter="Playlists" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView x:Name="IndicatorPlaylists" HeightRequest="3" Color="Transparent"
                         HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <!-- Settings tab -->
            <VerticalStackLayout Spacing="0">
                <Label x:Name="NavSettings" Text="Settings" FontSize="14"
                       TextColor="{DynamicResource ThemeText}" Padding="14,8"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTabTapped" CommandParameter="Settings" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView x:Name="IndicatorSettings" HeightRequest="3" Color="Transparent"
                         HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <!-- Separator line -->
        <BoxView HeightRequest="1" Color="{DynamicResource ThemeBorder}" HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentView>
