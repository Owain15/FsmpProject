<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:models="clr-namespace:FSMP.Core.Models;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.NowPlayingPage"
             x:DataType="vm:NowPlayingViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Now Playing">
    <Grid x:Name="RootGrid" ColumnDefinitions="*,Auto">

        <!-- Column 0: Player (fixed layout, no scroll) -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,10">
                <Label Text="Now Playing" FontSize="24" FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                <Button x:Name="QueueToggleButton" Grid.Column="1" Text="&#x2630; Queue"
                        Clicked="OnToggleQueue" Padding="8,4" VerticalOptions="Center" />
            </Grid>

            <!-- Row 1: Track display -->
            <VerticalStackLayout Grid.Row="1" Padding="16,0" Spacing="2">
                <Label Text="{Binding TrackTitle}" FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeText}" />
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding TrackArtist}" FontSize="14" TextColor="Gray" />
                    <Label Text="·" FontSize="14" TextColor="Gray" />
                    <Label Text="{Binding TrackAlbum}" FontSize="14" TextColor="DarkGray" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Row 2: Album art placeholder (flexible, absorbs resize) -->
            <Grid x:Name="AlbumArtArea" Grid.Row="2" Padding="16">
                <BoxView x:Name="AlbumArtPlaceholder" Color="{DynamicResource ThemeBackground}"
                         HorizontalOptions="Center" VerticalOptions="Center"
                         WidthRequest="200" HeightRequest="200" CornerRadius="8" />
            </Grid>

            <!-- Row 3: Footer controls -->
            <Grid Grid.Row="3" Padding="16,10" RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="8">

                <!-- Row 0: Playback state -->
                <Label Grid.Row="0"
                       Text="{Binding PlaybackState}" FontSize="12" TextColor="Gray" />

                <!-- Row 1: Progress slider -->
                <Slider Grid.Row="1" x:Name="ProgressSlider"
                        Minimum="0" Maximum="1"
                        Value="{Binding Progress, Mode=TwoWay}"
                        DragStarted="OnSeekStarted"
                        DragCompleted="OnSeekCompleted" />

                <!-- Row 2: Time+Volume (left) | Transport buttons (center) -->
                <VerticalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="0">
                        <Label Text="{Binding PositionText}" FontSize="12" />
                        <Label Text=" / " FontSize="12" />
                        <Label Text="{Binding DurationText}" FontSize="12" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Volume" VerticalOptions="Center" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" WidthRequest="150" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Row="2" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <c:IconButton Icon="⏮" Label="Prev" Command="{Binding PreviousCommand}" ButtonWidthRequest="90" />
                    <c:IconButton Icon="⏯" Command="{Binding PlayPauseCommand}" ButtonWidthRequest="60" />
                    <c:IconButton Icon="⏭" Label="Next" Command="{Binding NextCommand}" ButtonWidthRequest="90" />
                    <c:IconButton Icon="⏹" Label="Stop" Command="{Binding StopCommand}" ButtonWidthRequest="90" />
                </HorizontalStackLayout>

                <!-- Row 3: Repeat/Shuffle centered under transport -->
                <Grid Grid.Row="3">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Button Text="{Binding RepeatModeText}" Command="{Binding ToggleRepeatCommand}" WidthRequest="140" />
                        <Button Text="{Binding IsShuffled, StringFormat='🔀 Shuffle: {0}'}"
                                Command="{Binding ToggleShuffleCommand}" WidthRequest="140" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>

        </Grid>

        <!-- Column 1: Queue sidebar (hidden by default) -->
        <Border x:Name="QueueSidebar" Grid.Column="1" IsVisible="False"
                WidthRequest="300"
                BackgroundColor="{DynamicResource ThemeBackground}"
                Stroke="{DynamicResource ThemeText}" StrokeThickness="0.5"
                Padding="0">
            <Grid RowDefinitions="Auto,*">
                <!-- Sidebar header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8">
                    <Label Text="Queue" FontSize="20" FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="&#x2715;" Clicked="OnToggleQueue"
                            BackgroundColor="Transparent" FontSize="18"
                            TextColor="{DynamicResource ThemeText}"
                            WidthRequest="40" HeightRequest="40" Padding="0" />
                </Grid>

                <!-- Queue list -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding QueueItems}" SelectionMode="Single"
                                x:Name="QueueCollectionView"
                                SelectionChanged="OnQueueSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueItem">
                            <Grid Padding="4" ColumnDefinitions="30,*,Auto,60" ColumnSpacing="8">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0FF, Dark=#3A3A6A}" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Label Grid.Column="0" Text="{Binding Index}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Title}" />
                                <Label Grid.Column="2" Text="{Binding Artist}" TextColor="Gray" />
                                <Label Grid.Column="3" Text="{Binding Duration, StringFormat='{0:m\\:ss}'}" TextColor="Gray" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" Grid.ColumnSpan="2" IsVisible="True" BackgroundColor="#80000000" ZIndex="100">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" />
                <Label x:Name="StatusLabel" Text="Starting..." TextColor="White" FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
