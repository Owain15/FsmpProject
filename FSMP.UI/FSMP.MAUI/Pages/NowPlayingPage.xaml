<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:models="clr-namespace:FSMP.Core.Models;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.NowPlayingPage"
             x:DataType="vm:NowPlayingViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Now Playing">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Row 0: Top nav bar -->
        <c:TopNavBar x:Name="TopNav" CurrentRoute="NowPlaying" HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />

        <!-- Row 1: Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">

        <!-- Column 0: Player (fixed layout, no scroll) -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" IsClippedToBounds="True">

            <!-- Row 0: Header buttons -->
            <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="16,6" HorizontalOptions="End">
                <Button x:Name="QueueToggleButton" Text="&#x2630; Queue"
                        Clicked="OnToggleQueue" Padding="8,4" VerticalOptions="Center"
                        BackgroundColor="{DynamicResource ThemeBackground}"
                        TextColor="{DynamicResource ThemeText}"
                        BorderColor="{DynamicResource ThemeBorder}"
                        BorderWidth="1" />
                <Button x:Name="TagsToggleButton" Text="&#x1F3F7; Tags"
                        Clicked="OnToggleTags" Padding="8,4" VerticalOptions="Center"
                        BackgroundColor="{DynamicResource ThemeBackground}"
                        TextColor="{DynamicResource ThemeText}"
                        BorderColor="{DynamicResource ThemeBorder}"
                        BorderWidth="1" />
            </HorizontalStackLayout>

            <!-- Row 1: Track display -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="2" Padding="16,0">
                <Label Grid.Row="0" Text="{Binding TrackTitle}" FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeText}"
                       LineBreakMode="TailTruncation" MaxLines="1"
                       HorizontalOptions="Fill" />
                <Label Grid.Row="1" FontSize="14" TextColor="{DynamicResource ThemeTextSecondary}"
                       LineBreakMode="TailTruncation" MaxLines="1"
                       HorizontalOptions="Fill">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding TrackArtist}" />
                            <Span Text=" · " />
                            <Span Text="{Binding TrackAlbum}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <!-- Row 2: Album art placeholder (flexible, absorbs resize) -->
            <Grid x:Name="AlbumArtArea" Grid.Row="2" Padding="16">
                <BoxView x:Name="AlbumArtPlaceholder" Color="{DynamicResource ThemeBackground}"
                         HorizontalOptions="Center" VerticalOptions="Center"
                         WidthRequest="200" HeightRequest="200" CornerRadius="8" />
            </Grid>

            <!-- Row 3: Footer controls -->
            <Grid Grid.Row="3" Padding="16,10" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="8">

                <!-- Row 0: Playback state -->
                <Label Grid.Row="0"
                       Text="{Binding PlaybackState}" FontSize="12" TextColor="{DynamicResource ThemeTextSecondary}" />

                <!-- Row 1: Progress slider -->
                <Slider Grid.Row="1" x:Name="ProgressSlider"
                        Minimum="0" Maximum="1"
                        Value="{Binding Progress, Mode=TwoWay}"
                        DragStarted="OnSeekStarted"
                        DragCompleted="OnSeekCompleted" />

                <!-- Row 2: Time (left) | Volume (right) -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="{Binding PositionText}" FontSize="12" TextColor="{DynamicResource ThemeText}" />
                        <Label Text=" / " FontSize="12" TextColor="{DynamicResource ThemeText}" />
                        <Label Text="{Binding DurationText}" FontSize="12" TextColor="{DynamicResource ThemeText}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="🔊" VerticalOptions="Center" FontSize="16">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVolumeToggle" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="{Binding Volume}" WidthRequest="150" IsVisible="False" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Row 3: Transport buttons (centered) -->
                <HorizontalStackLayout Grid.Row="3" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <c:IconButton Icon="⏮" Label="Prev" Command="{Binding PreviousCommand}" />
                    <c:IconButton Icon="⏯" Command="{Binding PlayPauseCommand}" />
                    <c:IconButton Icon="⏭" Label="Next" Command="{Binding NextCommand}" />
                    <c:IconButton Icon="⏹" Label="Stop" Command="{Binding StopCommand}" />
                </HorizontalStackLayout>

                <!-- Row 4: Repeat/Shuffle centered under transport -->
                <Grid Grid.Row="4">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Button Text="{Binding RepeatModeText}" Command="{Binding ToggleRepeatCommand}"
                                BackgroundColor="{DynamicResource ThemeBackground}"
                                TextColor="{DynamicResource ThemeText}"
                                BorderColor="{DynamicResource ThemeBorder}"
                                BorderWidth="1" Padding="8,4" />
                        <Button Text="{Binding IsShuffled, StringFormat='🔀 Shuffle: {0}'}"
                                Command="{Binding ToggleShuffleCommand}"
                                BackgroundColor="{DynamicResource ThemeBackground}"
                                TextColor="{DynamicResource ThemeText}"
                                BorderColor="{DynamicResource ThemeBorder}"
                                BorderWidth="1" Padding="8,4" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>

        </Grid>

        <!-- Column 1: Queue sidebar (hidden by default) -->
        <Border x:Name="QueueSidebar" Grid.Column="1" IsVisible="False"
                WidthRequest="300"
                BackgroundColor="{DynamicResource ThemeBackground}"
                Stroke="{DynamicResource ThemeBorder}" StrokeThickness="0.5"
                Padding="0">
            <Grid RowDefinitions="Auto,*">
                <!-- Sidebar header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8">
                    <Label Text="Queue" FontSize="20" FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="&#x2715;" Clicked="OnToggleQueue"
                            BackgroundColor="Transparent" FontSize="18"
                            TextColor="{DynamicResource ThemeText}"
                            WidthRequest="40" HeightRequest="40" Padding="0" />
                </Grid>

                <!-- Queue list -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding QueueItems}" SelectionMode="Single"
                                x:Name="QueueCollectionView"
                                SelectionChanged="OnQueueSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueItem">
                            <Grid Padding="4" ColumnDefinitions="30,*,Auto,60" ColumnSpacing="8">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeHighlight}" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Label Grid.Column="0" Text="{Binding Index}" FontAttributes="Bold" TextColor="{DynamicResource ThemeText}" />
                                <Label Grid.Column="1" Text="{Binding Title}" TextColor="{DynamicResource ThemeText}" />
                                <Label Grid.Column="2" Text="{Binding Artist}" TextColor="{DynamicResource ThemeTextSecondary}" />
                                <Label Grid.Column="3" Text="{Binding Duration, StringFormat='{0:m\\:ss}'}" TextColor="{DynamicResource ThemeTextSecondary}" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Column 2: Tags sidebar (hidden by default) -->
        <Border x:Name="TagsSidebar" Grid.Column="2" IsVisible="False"
                WidthRequest="280"
                BackgroundColor="{DynamicResource ThemeBackground}"
                Stroke="{DynamicResource ThemeBorder}" StrokeThickness="0.5"
                Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Sidebar header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="Tags" FontSize="20" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeText}" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding TrackTitle}" FontSize="14"
                                   TextColor="{DynamicResource ThemeTextSecondary}" />
                            <Label Text="," FontSize="14" TextColor="{DynamicResource ThemeTextSecondary}" />
                            <Label Text="{Binding TrackArtist}" FontSize="14"
                                   TextColor="{DynamicResource ThemeTextSecondary}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#x2715;" Clicked="OnToggleTags"
                            BackgroundColor="Transparent" FontSize="18"
                            TextColor="{DynamicResource ThemeText}"
                            WidthRequest="40" HeightRequest="40" Padding="0" />
                </Grid>

                <!-- Filter entry + toggle button -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,4,12,0" ColumnSpacing="4">
                    <Entry Text="{Binding TagFilter}" Placeholder="Filter or add tag..."
                           TextColor="{DynamicResource ThemeText}" />
                    <Button Grid.Column="1" Text="&#x2630;"
                            Command="{Binding ToggleTagViewCommand}"
                            Padding="8,4" FontSize="14" WidthRequest="44"
                            BackgroundColor="{DynamicResource ThemeBackground}"
                            TextColor="{DynamicResource ThemeText}"
                            BorderColor="{DynamicResource ThemeBorder}"
                            BorderWidth="1" />
                </Grid>

                <!-- Current Tags view (default) -->
                <ScrollView Grid.Row="2" IsVisible="{Binding IsTagListMode, Converter={StaticResource InvertBoolConverter}}">
                    <VerticalStackLayout Padding="12,8,12,12" Spacing="8">

                        <Label Text="On this track" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeTextSecondary}" />
                        <CollectionView ItemsSource="{Binding TrackTags}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Tags">
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,2">
                                        <Label Text="{Binding Name}" VerticalOptions="Center"
                                               TextColor="{DynamicResource ThemeText}" />
                                        <Button Grid.Column="1" Text="&#x1F5D1;" Padding="4,2"
                                                FontSize="12" BackgroundColor="Transparent"
                                                TextColor="{DynamicResource ThemeTextSecondary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NowPlayingViewModel}}, Path=RemoveTagFromTrackCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Create new tag button -->
                        <Button Text="{Binding TagFilter, StringFormat='Create &quot;{0}&quot;'}"
                                IsVisible="{Binding ShowCreateNew}"
                                Command="{Binding CreateAndAddTagCommand}"
                                Padding="8,4" HorizontalOptions="Start"
                                BackgroundColor="{DynamicResource ThemeBackground}"
                                TextColor="{DynamicResource ThemeText}"
                                BorderColor="{DynamicResource ThemeBorder}"
                                BorderWidth="1" />

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Tag List view -->
                <Grid Grid.Row="2" IsVisible="{Binding IsTagListMode}" RowDefinitions="Auto,*"
                      Padding="12,8,12,12">
                    <!-- Header: Tag List + Apply -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="0,0,0,8">
                        <Label Text="Tag List" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Apply"
                                Command="{Binding ApplyPendingTagsCommand}"
                                IsEnabled="{Binding HasPendingChanges}"
                                Padding="8,4" FontSize="12"
                                BackgroundColor="{DynamicResource ThemeBackground}"
                                TextColor="{DynamicResource ThemeText}"
                                BorderColor="{DynamicResource ThemeBorder}"
                                BorderWidth="1" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding TagListItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TagListItem">
                                <Grid ColumnDefinitions="30,*,Auto" Padding="4,2" ColumnSpacing="4">
                                    <!-- Checkbox indicator -->
                                    <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="3"
                                             HorizontalOptions="Center" VerticalOptions="Center">
                                        <BoxView.Color>
                                            <MultiBinding Converter="{StaticResource TagCheckboxColorConverter}">
                                                <Binding Path="IsSaved" />
                                                <Binding Path="IsPendingChange" />
                                            </MultiBinding>
                                        </BoxView.Color>
                                        <BoxView.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NowPlayingViewModel}}, Path=TogglePendingCommand}"
                                                CommandParameter="{Binding}" />
                                        </BoxView.GestureRecognizers>
                                    </BoxView>

                                    <!-- Tag name -->
                                    <Label Grid.Column="1" Text="{Binding Tag.Name}"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource ThemeText}" />

                                    <!-- Bin button (visible when saved) -->
                                    <Button Grid.Column="2" Text="&#x1F5D1;" Padding="4,2" FontSize="12"
                                            BackgroundColor="Transparent" TextColor="{DynamicResource ThemeTextSecondary}"
                                            IsVisible="{Binding IsSaved}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NowPlayingViewModel}}, Path=QuickRemoveTagCommand}"
                                            CommandParameter="{Binding}" />

                                    <!-- Add button (visible when not saved) -->
                                    <Button Grid.Column="2" Text="＋" Padding="4,2" FontSize="12"
                                            BackgroundColor="Transparent" TextColor="{DynamicResource ThemeTextSecondary}"
                                            IsVisible="{Binding IsSaved, Converter={StaticResource InvertBoolConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NowPlayingViewModel}}, Path=QuickAddTagCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Create new tag button -->
                    <Button Grid.Row="1" Text="{Binding TagFilter, StringFormat='Create &quot;{0}&quot;'}"
                            IsVisible="{Binding ShowCreateNew}"
                            Command="{Binding CreateAndAddTagCommand}"
                            Padding="8,4" HorizontalOptions="Start" VerticalOptions="End"
                            BackgroundColor="{DynamicResource ThemeBackground}"
                            TextColor="{DynamicResource ThemeText}"
                            BorderColor="{DynamicResource ThemeBorder}"
                            BorderWidth="1" />
                </Grid>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" Grid.ColumnSpan="3" IsVisible="True" BackgroundColor="{DynamicResource ThemeOverlay}" ZIndex="100">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource ThemeOnOverlay}" />
                <Label x:Name="StatusLabel" Text="Starting..." TextColor="{DynamicResource ThemeOnOverlay}" FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        </Grid>

        <!-- Nav menu overlay (for hamburger menu) -->
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
