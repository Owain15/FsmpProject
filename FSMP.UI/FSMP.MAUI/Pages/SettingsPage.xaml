<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FSMP.MAUI.Pages.SettingsPage"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="Settings" FontSize="24" FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeText}" Margin="0,0,0,8" />

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLibraryTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="📁" FontSize="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Library" FontSize="16" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="22"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlaybackTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🔊" FontSize="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Playback" FontSize="16" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="22"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAppearanceTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🎨" FontSize="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Appearance" FontSize="16" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="22"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBehaviorTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="⚙️" FontSize="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Behavior" FontSize="16" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="22"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAboutTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="ℹ️" FontSize="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="About" FontSize="16" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="22"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
