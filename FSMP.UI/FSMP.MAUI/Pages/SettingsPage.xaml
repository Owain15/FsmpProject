<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.SettingsPage"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Settings">
    <Grid RowDefinitions="Auto,*">

        <!-- Top nav bar -->
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Settings" HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />

        <Grid Grid.Row="1">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">


            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLibraryTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="📁" FontSize="{DynamicResource TextSizeTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Directories" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="{DynamicResource TextSizeHeading}"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlaybackTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🔊" FontSize="{DynamicResource TextSizeTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Playback" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="{DynamicResource TextSizeHeading}"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAppearanceTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🎨" FontSize="{DynamicResource TextSizeTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Appearance" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="{DynamicResource TextSizeHeading}"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBehaviorTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="⚙️" FontSize="{DynamicResource TextSizeTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Behavior" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="{DynamicResource TextSizeHeading}"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource ThemeBorder}"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    Padding="16" Margin="0,2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAboutTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="ℹ️" FontSize="{DynamicResource TextSizeTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="About" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" Margin="12,0,0,0" />
                    <Label Grid.Column="2" Text="›" FontSize="{DynamicResource TextSizeHeading}"
                           TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
        </Grid>

        <!-- Nav menu overlay -->
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
