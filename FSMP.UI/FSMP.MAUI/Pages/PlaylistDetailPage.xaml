<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:models="clr-namespace:FSMP.Core.Models;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.PlaylistDetailPage"
             x:DataType="vm:PlaylistDetailViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Edit Playlist">
    <VerticalStackLayout Padding="16" Spacing="12">

        <!-- Header with back button -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Text="← Back" FontSize="{DynamicResource TextSizeBody}" Padding="10,4"
                    BackgroundColor="{DynamicResource ThemeButtonBackground}"
                    TextColor="{DynamicResource ThemeButtonText}"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Edit Playlist" FontSize="{DynamicResource TextSizeHeading}" FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
        </Grid>

        <!-- Rename -->
        <Label Text="Playlist Name" FontSize="{DynamicResource TextSizeBody}" FontAttributes="Bold"
               TextColor="{DynamicResource ThemeText}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="NameEntry" Text="{Binding PlaylistName}" FontSize="{DynamicResource TextSizeBody}" />
            <c:IconButton Grid.Column="1" Icon="✎" Label="Rename"
                    Command="{Binding RenameCommand}"
                    CommandParameter="{Binding Source={x:Reference NameEntry}, Path=Text}" />
        </Grid>

        <!-- Status -->
        <Label Text="{Binding StatusMessage}" FontSize="{DynamicResource TextSizeBody}" TextColor="{DynamicResource ThemeTextSecondary}" />

        <!-- Tracks -->
        <Label Text="Tracks" FontSize="{DynamicResource TextSizeTitle}" FontAttributes="Bold"
               TextColor="{DynamicResource ThemeText}" />
        <CollectionView ItemsSource="{Binding Tracks}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistTrack">
                    <Grid Padding="8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Position}" FontSize="{DynamicResource TextSizeBody}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <Label Grid.Column="1" Text="{Binding Track.Title}" FontSize="{DynamicResource TextSizeBody}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <c:IconButton Grid.Column="2" Icon="✕"
                                ButtonTextColor="{DynamicResource ThemeError}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistDetailViewModel}}, Path=RemoveTrackCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No tracks in this playlist." TextColor="{DynamicResource ThemeTextSecondary}" Padding="8" />
            </CollectionView.EmptyView>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
