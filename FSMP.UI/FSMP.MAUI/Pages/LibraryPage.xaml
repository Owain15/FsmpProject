<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:models="clr-namespace:FSMP.Core.Models;assembly=FSMP.Core"
             xmlns:sel="clr-namespace:FSMP.MAUI.Selectors"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.LibraryPage"
             x:DataType="vm:LibraryBrowseViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <sel:LibraryItemTemplateSelector x:Key="ItemSelector">
            <sel:LibraryItemTemplateSelector.ArtistTemplate>
                <DataTemplate x:DataType="models:Artist">
                    <Grid Padding="8" ColumnDefinitions="*">
                        <Label Text="{Binding Name}" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryBrowseViewModel}}, Path=SelectItemCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </sel:LibraryItemTemplateSelector.ArtistTemplate>

            <sel:LibraryItemTemplateSelector.AlbumTemplate>
                <DataTemplate x:DataType="models:Album">
                    <Grid Padding="8" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Title}" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <Label Grid.Column="1" Text="{Binding Year, StringFormat='{0}'}"
                               FontSize="{DynamicResource TextSizeSmall}" TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryBrowseViewModel}}, Path=SelectItemCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </sel:LibraryItemTemplateSelector.AlbumTemplate>

            <sel:LibraryItemTemplateSelector.TrackTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="8" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Label Text="{Binding TrackNumber, StringFormat='{0}.'}"
                               FontSize="{DynamicResource TextSizeBody}" TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding DisplayTitle}"
                               FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <c:IconButton Grid.Column="2" Icon="▶" Label="Play"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryBrowseViewModel}}, Path=PlayNowCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3" Text="＋" WidthRequest="40" FontSize="{DynamicResource TextSizeSmall}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryBrowseViewModel}}, Path=AddToQueueCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{DynamicResource ThemeBackground}"
                                TextColor="{DynamicResource ThemeText}"
                                BorderColor="{DynamicResource ThemeBorder}"
                                BorderWidth="1" />
                    </Grid>
                </DataTemplate>
            </sel:LibraryItemTemplateSelector.TrackTemplate>
        </sel:LibraryItemTemplateSelector>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Top nav bar -->
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Library" HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />

        <Grid Grid.Row="1">
        <VerticalStackLayout Padding="16" Spacing="8">

            <!-- Actions -->
            <HorizontalStackLayout Spacing="8">
                <c:IconButton Icon="▶" Label="All" Command="{Binding PlayAllCommand}" />
                <c:IconButton Icon="←" Label="Back" Command="{Binding GoBackCommand}"
                        IsVisible="{Binding CanGoBack}" />
                <c:IconButton Icon="✕" Label="Filter" Command="{Binding ClearTagFilterCommand}"
                        IsVisible="{Binding HasTagFilter}" />
            </HorizontalStackLayout>

            <!-- Tag filter chips -->
            <CollectionView ItemsSource="{Binding AvailableTags}" SelectionMode="None"
                            HeightRequest="40">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tags">
                        <Border StrokeShape="RoundRectangle 12" Padding="8,4" BackgroundColor="{DynamicResource ThemeChipBackground}">
                            <Label Text="{Binding Name}" FontSize="{DynamicResource TextSizeSmall}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryBrowseViewModel}}, Path=FilterByTagCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Items list -->
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None"
                            ItemTemplate="{StaticResource ItemSelector}" />

        </VerticalStackLayout>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" IsVisible="True" BackgroundColor="{DynamicResource ThemeOverlay}" ZIndex="100">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource ThemeOnOverlay}" />
                <Label x:Name="StatusLabel" Text="Starting..." TextColor="{DynamicResource ThemeOnOverlay}" FontSize="{DynamicResource TextSizeBody}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        </Grid>

        <!-- Nav menu overlay -->
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
