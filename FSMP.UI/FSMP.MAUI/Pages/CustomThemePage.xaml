<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.MAUI.ViewModels"
             x:Class="FSMP.MAUI.Pages.CustomThemePage"
             x:DataType="vm:CustomThemeViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Shell.NavBarIsVisible="False"
             Title="Custom Theme">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: Header with back button -->
        <Grid Grid.Row="0" Padding="8,8,8,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Text="← Back" FontSize="14" Padding="10,4"
                    BackgroundColor="{DynamicResource ThemeButtonBackground}"
                    TextColor="{DynamicResource ThemeButtonText}"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Custom Theme" FontSize="24" FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
        </Grid>

        <!-- Row 1: Mini App Card Preview -->
        <Border Grid.Row="1" Padding="0" Margin="8,4,8,0"
                BackgroundColor="{Binding PreviewColors[ThemeBackground]}"
                Stroke="{Binding PreviewColors[ThemeBorder]}" StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="0">

                <!-- 1. Shell bar (16px) -->
                <Grid HeightRequest="16" Padding="6,0"
                      BackgroundColor="{Binding PreviewColors[ThemeShellBackground]}"
                      ColumnDefinitions="Auto,Auto,*,Auto">
                    <Label Text="Library" FontSize="7" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{Binding PreviewColors[ThemeShellTabSelected]}" />
                    <Label Grid.Column="1" Text="  Settings" FontSize="7" VerticalOptions="Center" Margin="4,0,0,0"
                           TextColor="{Binding PreviewColors[ThemeShellTabUnselected]}" />
                    <BoxView Grid.Column="3" WidthRequest="20" HeightRequest="3" CornerRadius="1"
                             Color="{Binding PreviewColors[ThemeShellTabBar]}" VerticalOptions="End" />
                </Grid>

                <!-- 2. Title + buttons row (20px) -->
                <Grid HeightRequest="20" Padding="6,2"
                      BackgroundColor="{Binding PreviewColors[ThemeBackground]}"
                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="3">
                    <Label Text="Now Playing" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{Binding PreviewColors[ThemeText]}" />
                    <Border Grid.Column="1" Padding="4,1" StrokeThickness="0"
                            BackgroundColor="{Binding PreviewColors[ThemeButtonBackground]}"
                            StrokeShape="RoundRectangle 3">
                        <Label Text="Scan" FontSize="7" TextColor="{Binding PreviewColors[ThemeButtonText]}" />
                    </Border>
                    <Border Grid.Column="2" Padding="4,1" StrokeThickness="0"
                            BackgroundColor="{Binding PreviewColors[ThemeButtonDisabledBg]}"
                            StrokeShape="RoundRectangle 3">
                        <Label Text="+" FontSize="7" TextColor="{Binding PreviewColors[ThemeButtonDisabledText]}" />
                    </Border>
                </Grid>

                <!-- 3. Track row (16px) -->
                <Grid HeightRequest="16" Padding="6,0"
                      BackgroundColor="{Binding PreviewColors[ThemeBackground]}"
                      ColumnDefinitions="Auto,*,Auto">
                    <Label Text="♫ Track Name" FontSize="8" VerticalOptions="Center"
                           TextColor="{Binding PreviewColors[ThemeText]}" />
                    <Label Grid.Column="2" Text="Artist" FontSize="8" VerticalOptions="Center"
                           TextColor="{Binding PreviewColors[ThemeTextSecondary]}" />
                </Grid>

                <!-- 4. Slider row (14px) -->
                <Grid HeightRequest="14" Padding="6,0"
                      BackgroundColor="{Binding PreviewColors[ThemeBackground]}">
                    <Grid ColumnDefinitions="3*,7*" HeightRequest="4" VerticalOptions="Center">
                        <BoxView CornerRadius="2" Color="{Binding PreviewColors[ThemeSliderTrack]}" />
                        <BoxView Grid.Column="1" CornerRadius="2" Color="{Binding PreviewColors[ThemeSliderTrackBg]}" />
                    </Grid>
                </Grid>

                <!-- 5. Chips + card + accents row (20px) -->
                <Grid HeightRequest="20" Padding="6,2"
                      BackgroundColor="{Binding PreviewColors[ThemeSurface]}"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="3">
                    <!-- Chip 1 -->
                    <Border Padding="4,1" StrokeThickness="0"
                            BackgroundColor="{Binding PreviewColors[ThemeChipBackground]}"
                            StrokeShape="RoundRectangle 3">
                        <Label Text="Rock" FontSize="7" TextColor="{Binding PreviewColors[ThemeText]}" />
                    </Border>
                    <!-- Chip 2 / mini entry -->
                    <Border Grid.Column="1" Padding="4,1" StrokeThickness="0"
                            BackgroundColor="{Binding PreviewColors[ThemeChipBackground]}"
                            StrokeShape="RoundRectangle 3">
                        <Label Text="search..." FontSize="7" FontAttributes="Italic"
                               TextColor="{Binding PreviewColors[ThemeEntryPlaceholder]}" />
                    </Border>
                    <!-- Entry text sample -->
                    <Label Grid.Column="2" Text="abc" FontSize="7" VerticalOptions="Center" Margin="2,0"
                           TextColor="{Binding PreviewColors[ThemeEntryText]}" />
                    <!-- Mini card with highlight accent + overlay -->
                    <Border Grid.Column="3" Padding="0" StrokeThickness="1"
                            Stroke="{Binding PreviewColors[ThemeBorder]}"
                            BackgroundColor="{Binding PreviewColors[ThemeCardBackground]}"
                            StrokeShape="RoundRectangle 3">
                        <Grid ColumnDefinitions="3,*">
                            <!-- Highlight accent strip -->
                            <BoxView WidthRequest="3" Color="{Binding PreviewColors[ThemeHighlight]}" />
                            <Grid Grid.Column="1">
                                <!-- Overlay strip -->
                                <BoxView Opacity="0.5" Color="{Binding PreviewColors[ThemeOverlay]}" />
                                <Label Text="card" FontSize="7" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{Binding PreviewColors[ThemeOnOverlay]}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Primary dot -->
                    <BoxView Grid.Column="4" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                             Color="{Binding PreviewColors[ThemePrimary]}" VerticalOptions="Center" />
                    <!-- Secondary dot -->
                    <BoxView Grid.Column="5" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                             Color="{Binding PreviewColors[ThemeSecondary]}" VerticalOptions="Center" />
                </Grid>

                <!-- 6. Error bar (14px, conditional) -->
                <Grid HeightRequest="14" Padding="4,0"
                      BackgroundColor="{Binding PreviewColors[ThemeError]}"
                      IsVisible="{Binding IsErrorSelected}">
                    <Label Text="⚠ Error message" FontSize="7" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{Binding PreviewColors[ThemeButtonText]}" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Row 2: Middle — Variables list + Color picker -->
        <Grid Grid.Row="2" Margin="8,4,8,0">

            <!-- Wide layout: side-by-side -->
            <Grid IsVisible="{Binding IsWideLayout}" ColumnDefinitions="*,300" ColumnSpacing="8">

                <!-- Variables list -->
                <ScrollView Grid.Column="0">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="8" Margin="8,0,0,4">
                            <Label Text="Advanced mode" FontSize="12" VerticalOptions="Center"
                                   TextColor="{DynamicResource ThemeText}" />
                            <Switch IsToggled="{Binding IsAdvancedMode}"
                                    OnColor="{DynamicResource ThemePrimary}" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding FilteredColors}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedColor}"
                                        SelectionChangedCommand="{Binding SelectionChangedCommand}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorEntry">
                                    <Grid Padding="8,6" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                          BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}">
                                        <BoxView WidthRequest="28" HeightRequest="28" CornerRadius="4"
                                                 Color="{Binding ColorPreview}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}" FontSize="13"
                                                   TextColor="{DynamicResource ThemeText}" />
                                            <Label Text="{Binding Key}" FontSize="9"
                                                   TextColor="{DynamicResource ThemeTextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Color picker sidebar -->
                <Border Grid.Column="1" Padding="12"
                        BackgroundColor="{DynamicResource ThemeCardBackground}"
                        Stroke="{DynamicResource ThemeBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasSelectedColor}">
                            <Label Text="{Binding SelectedColor.DisplayName}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                            <BoxView WidthRequest="24" HeightRequest="24" CornerRadius="4"
                                     Color="{Binding SelectedColor.ColorPreview}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Select a color variable to edit"
                               FontSize="14" FontAttributes="Italic"
                               TextColor="{DynamicResource ThemeTextSecondary}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasSelectedColor}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding HasSelectedColor}">
                            <Grid ColumnDefinitions="30,*,40" ColumnSpacing="4">
                                <Label Text="H" FontSize="13" VerticalOptions="Center" FontAttributes="Bold"
                                       TextColor="{DynamicResource ThemeText}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="360"
                                        Value="{Binding SelectedColor.Hue}" />
                                <Label Grid.Column="2" Text="{Binding SelectedColor.Hue, StringFormat='{0:F0}'}" FontSize="13"
                                       TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="30,*,40" ColumnSpacing="4">
                                <Label Text="S" FontSize="13" VerticalOptions="Center" FontAttributes="Bold"
                                       TextColor="{DynamicResource ThemeText}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="{Binding SelectedColor.Saturation}" />
                                <Label Grid.Column="2" Text="{Binding SelectedColor.Saturation, StringFormat='{0:F0}'}" FontSize="13"
                                       TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="30,*,40" ColumnSpacing="4">
                                <Label Text="B" FontSize="13" VerticalOptions="Center" FontAttributes="Bold"
                                       TextColor="{DynamicResource ThemeText}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="{Binding SelectedColor.Brightness}" />
                                <Label Grid.Column="2" Text="{Binding SelectedColor.Brightness, StringFormat='{0:F0}'}" FontSize="13"
                                       TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Hex:" FontSize="13" VerticalOptions="Center"
                                       TextColor="{DynamicResource ThemeText}" />
                                <Entry Grid.Column="1" Text="{Binding SelectedColor.HexValue}" FontSize="13"
                                       TextColor="{DynamicResource ThemeEntryText}"
                                       PlaceholderColor="{DynamicResource ThemeEntryPlaceholder}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Narrow layout: one at a time -->
            <Grid IsVisible="{Binding IsNarrowLayout}">

                <!-- Variables list (narrow) -->
                <ScrollView IsVisible="{Binding ShowVariablesList}">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="8" Margin="8,0,0,4">
                            <Label Text="Advanced mode" FontSize="12" VerticalOptions="Center"
                                   TextColor="{DynamicResource ThemeText}" />
                            <Switch IsToggled="{Binding IsAdvancedMode}"
                                    OnColor="{DynamicResource ThemePrimary}" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding FilteredColors}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedColor}"
                                        SelectionChangedCommand="{Binding SelectionChangedCommand}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorEntry">
                                    <Grid Padding="8,6" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                          BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}">
                                        <BoxView WidthRequest="28" HeightRequest="28" CornerRadius="4"
                                                 Color="{Binding ColorPreview}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}" FontSize="13"
                                                   TextColor="{DynamicResource ThemeText}" />
                                            <Label Text="{Binding Key}" FontSize="9"
                                                   TextColor="{DynamicResource ThemeTextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Color picker (narrow) -->
                <VerticalStackLayout IsVisible="{Binding ShowColorPicker}" Spacing="10" Padding="8">
                    <Button Text="← Back to list" FontSize="12" HorizontalOptions="Start"
                            BackgroundColor="{DynamicResource ThemeButtonBackground}"
                            TextColor="{DynamicResource ThemeButtonText}"
                            Command="{Binding BackToListCommand}"
                            IsVisible="{Binding ShowBackButton}" Padding="10,4" />
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasSelectedColor}">
                        <Label Text="{Binding SelectedColor.DisplayName}" FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                        <BoxView WidthRequest="24" HeightRequest="24" CornerRadius="4"
                                 Color="{Binding SelectedColor.ColorPreview}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasSelectedColor}">
                        <Grid ColumnDefinitions="30,*,40" ColumnSpacing="4">
                            <Label Text="H" FontSize="13" VerticalOptions="Center" FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="360"
                                    Value="{Binding SelectedColor.Hue}" />
                            <Label Grid.Column="2" Text="{Binding SelectedColor.Hue, StringFormat='{0:F0}'}" FontSize="13"
                                   TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="30,*,40" ColumnSpacing="4">
                            <Label Text="S" FontSize="13" VerticalOptions="Center" FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="{Binding SelectedColor.Saturation}" />
                            <Label Grid.Column="2" Text="{Binding SelectedColor.Saturation, StringFormat='{0:F0}'}" FontSize="13"
                                   TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="30,*,40" ColumnSpacing="4">
                            <Label Text="B" FontSize="13" VerticalOptions="Center" FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="{Binding SelectedColor.Brightness}" />
                            <Label Grid.Column="2" Text="{Binding SelectedColor.Brightness, StringFormat='{0:F0}'}" FontSize="13"
                                   TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="Hex:" FontSize="13" VerticalOptions="Center"
                                   TextColor="{DynamicResource ThemeText}" />
                            <Entry Grid.Column="1" Text="{Binding SelectedColor.HexValue}" FontSize="13"
                                   TextColor="{DynamicResource ThemeEntryText}"
                                   PlaceholderColor="{DynamicResource ThemeEntryPlaceholder}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Row 3: Footer -->
        <Grid Grid.Row="3" Padding="8" RowDefinitions="Auto,Auto" RowSpacing="6"
              BackgroundColor="{DynamicResource ThemeCardBackground}">

            <!-- Load dropdown + delete -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Picker ItemsSource="{Binding PresetAndSavedThemes}"
                        SelectedItem="{Binding SelectedDropdownTheme}"
                        Title="Load theme..."
                        FontSize="12" />
                <Button Grid.Column="1" Text="🗑" FontSize="14" Padding="8,2"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Command="{Binding DeleteSavedThemeCommand}"
                        IsVisible="{Binding CanDeleteSelectedTheme}" />
            </Grid>

            <!-- Reset / Save / Cancel -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Reset" FontSize="14"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Command="{Binding ResetCommand}" />
                <Button Grid.Column="1" Text="Save" FontSize="14"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="2" Text="Cancel" FontSize="14"
                        BackgroundColor="{DynamicResource ThemeButtonDisabledBg}"
                        TextColor="{DynamicResource ThemeText}"
                        Clicked="OnCancelClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
