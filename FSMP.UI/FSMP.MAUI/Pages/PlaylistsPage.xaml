<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:models="clr-namespace:FSMP.Core.Models;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.PlaylistsPage"
             x:DataType="vm:PlaylistsViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Playlists">
    <Grid RowDefinitions="Auto,*">

        <!-- Top nav bar -->
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Playlists" HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />

        <Grid Grid.Row="1">
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Create new playlist -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="PlaylistNameEntry" Placeholder="New playlist name" FontSize="{DynamicResource TextSizeBody}" />
                <c:IconButton Grid.Column="1" Icon="＋" Label="Create"
                        Command="{Binding CreatePlaylistCommand}"
                        CommandParameter="{Binding Source={x:Reference PlaylistNameEntry}, Path=Text}" />
            </Grid>

            <!-- Status -->
            <Label Text="{Binding StatusMessage}" FontSize="{DynamicResource TextSizeBody}" TextColor="{DynamicResource ThemeTextSecondary}" />

            <!-- Playlist list -->
            <CollectionView ItemsSource="{Binding Playlists}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Playlist">
                        <Grid Padding="8" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="{DynamicResource TextSizeSubtitle}" FontAttributes="Bold" TextColor="{DynamicResource ThemeText}" />
                                <Label Text="{Binding Description}" FontSize="{DynamicResource TextSizeSmall}" TextColor="{DynamicResource ThemeTextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✎ Edit" FontSize="{DynamicResource TextSizeSmall}"
                                    Clicked="OnEditPlaylistClicked"
                                    CommandParameter="{Binding .}" />
                            <c:IconButton Grid.Column="2" Icon="▶" Label="Load"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistsViewModel}}, Path=LoadIntoQueueCommand}"
                                    CommandParameter="{Binding .}" />
                            <c:IconButton Grid.Column="3" Icon="🗑" Label="Delete"
                                    ButtonTextColor="{DynamicResource ThemeError}"
                                    Clicked="OnDeletePlaylistClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No playlists yet. Create one above!" TextColor="{DynamicResource ThemeTextSecondary}" Padding="8" />
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" IsVisible="True" BackgroundColor="{DynamicResource ThemeOverlay}" ZIndex="100">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource ThemeOnOverlay}" />
                <Label x:Name="StatusLabel" Text="Starting..." TextColor="{DynamicResource ThemeOnOverlay}" FontSize="{DynamicResource TextSizeBody}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        </Grid>

        <!-- Nav menu overlay -->
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
