<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.Settings.AppearanceSettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Appearance"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Settings"
                     HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Button Text="← Back" FontSize="{DynamicResource TextSizeBody}" Padding="12,6"
                        HorizontalOptions="End"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Clicked="OnBackClicked" />

                <!-- Theme section -->
                <Label Text="Theme" FontSize="{DynamicResource TextSizeSubtitle}" TextColor="{DynamicResource ThemeText}" />
                <Label Text="Choose your app colour scheme" FontSize="{DynamicResource TextSizeSmall}" TextColor="{DynamicResource ThemeTextSecondary}" />
                <Picker x:Name="ThemePicker"
                        ItemsSource="{Binding AvailableThemes}"
                        SelectedItem="{Binding SelectedTheme}"
                        FontSize="{DynamicResource TextSizeSubtitle}" />

                <BoxView HeightRequest="1" Color="{DynamicResource ThemeTextSecondary}" Opacity="0.3" Margin="0,8" />

                <!-- Text Size section -->
                <Label Text="Text Size" FontSize="{DynamicResource TextSizeSubtitle}" TextColor="{DynamicResource ThemeText}" />
                <Label Text="Adjust font size across the app" FontSize="{DynamicResource TextSizeSmall}" TextColor="{DynamicResource ThemeTextSecondary}" />
                <Picker x:Name="TextSizePicker"
                        ItemsSource="{Binding AvailableTextSizes}"
                        SelectedItem="{Binding TextSize}"
                        SelectedIndexChanged="OnTextSizePickerChanged"
                        FontSize="{DynamicResource TextSizeSubtitle}" />

            </VerticalStackLayout>
        </ScrollView>
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
