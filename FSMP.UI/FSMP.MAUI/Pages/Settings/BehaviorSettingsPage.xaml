<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.Settings.BehaviorSettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Behavior"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Settings"
                     HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Button Text="← Back" FontSize="{DynamicResource TextSizeBody}" Padding="12,6"
                        HorizontalOptions="End"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Clicked="OnBackClicked" />

                <!-- Library Section -->
                <Label Text="Library" FontSize="{DynamicResource TextSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeText}" />
                <Label Text="Default actions when browsing your library"
                       FontSize="{DynamicResource TextSizeSmall}" TextColor="{DynamicResource ThemeTextSecondary}" />

                <Label Text="Double-click action" FontSize="{DynamicResource TextSizeBody}"
                       TextColor="{DynamicResource ThemeText}" />
                <Picker ItemsSource="{Binding AvailableDoubleClickActions}"
                        SelectedItem="{Binding DoubleClickAction}"
                        FontSize="{DynamicResource TextSizeBody}" />

                <Label Text="Default sort order" FontSize="{DynamicResource TextSizeBody}"
                       TextColor="{DynamicResource ThemeText}" />
                <Picker ItemsSource="{Binding AvailableSortOrders}"
                        SelectedItem="{Binding DefaultSortOrder}"
                        FontSize="{DynamicResource TextSizeBody}" />

                <BoxView HeightRequest="1" Color="{DynamicResource ThemeTextSecondary}" Opacity="0.3" Margin="0,8" />

                <!-- Reset Section -->
                <Label Text="Reset" FontSize="{DynamicResource TextSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeText}" />
                <Label Text="Restore all settings to their original values"
                       FontSize="{DynamicResource TextSizeSmall}" TextColor="{DynamicResource ThemeTextSecondary}" />

                <c:IconButton Icon="🔄" Label="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}"
                        HorizontalOptions="Start" />

            </VerticalStackLayout>
        </ScrollView>
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
