<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.Settings.PlaybackSettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Playback"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Playback" FontSize="24" FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeText}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="← Back" FontSize="14" Padding="12,6"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Clicked="OnBackClicked" />
            </Grid>

            <Label Text="{Binding DefaultVolume, StringFormat='Default Volume: {0}%'}" FontSize="16"
                   TextColor="{DynamicResource ThemeText}" />
            <Slider Minimum="0" Maximum="100" Value="{Binding DefaultVolume}" />

            <c:IconButton Icon="💾" Label="Save" Command="{Binding SaveCommand}"
                    HorizontalOptions="Start" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
