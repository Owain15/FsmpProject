<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.Settings.PlaybackSettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Playback"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Settings"
                     HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Button Text="← Back" FontSize="{DynamicResource TextSizeBody}" Padding="12,6"
                        HorizontalOptions="End"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Clicked="OnBackClicked" />

                <Label Text="{Binding DefaultVolume, StringFormat='Default Volume: {0}%'}" FontSize="{DynamicResource TextSizeSubtitle}"
                       TextColor="{DynamicResource ThemeText}" />
                <Slider Minimum="0" Maximum="100" Value="{Binding DefaultVolume}" />

                <BoxView HeightRequest="1" Color="{DynamicResource ThemeTextSecondary}" Opacity="0.3" Margin="0,8" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Resume session on startup" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" />
                    <Switch Grid.Column="1" IsToggled="{Binding ResumeSession}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Auto-play on startup" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" />
                    <Switch Grid.Column="1" IsToggled="{Binding AutoPlayOnStartup}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
