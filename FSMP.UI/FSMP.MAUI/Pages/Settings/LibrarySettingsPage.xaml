<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FSMP.Core.ViewModels;assembly=FSMP.Core"
             xmlns:c="clr-namespace:FSMP.MAUI.Components"
             x:Class="FSMP.MAUI.Pages.Settings.LibrarySettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{DynamicResource ThemeBackground}"
             Title="Directories"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <c:TopNavBar x:Name="TopNav" CurrentRoute="Settings"
                     HamburgerClicked="OnHamburgerClicked" Grid.Row="0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Button Text="← Back" FontSize="{DynamicResource TextSizeBody}" Padding="12,6"
                        HorizontalOptions="End"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        Clicked="OnBackClicked" />

                <!-- Manage Directories sub-page navigation -->
                <Button Text="Manage Directories" FontSize="{DynamicResource TextSizeSubtitle}" Padding="12,8"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        HorizontalOptions="Start"
                        Clicked="OnManageDirectoriesClicked" />

                <!-- Scan Library sub-page navigation -->
                <Button Text="Scan Library" FontSize="{DynamicResource TextSizeSubtitle}" Padding="12,8"
                        BackgroundColor="{DynamicResource ThemeButtonBackground}"
                        TextColor="{DynamicResource ThemeButtonText}"
                        HorizontalOptions="Start"
                        Clicked="OnScanLibraryClicked" />

                <!-- Auto-scan toggle -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Auto-scan on startup" FontSize="{DynamicResource TextSizeSubtitle}" VerticalOptions="Center"
                           TextColor="{DynamicResource ThemeText}" />
                    <Switch Grid.Column="1" IsToggled="{Binding AutoScanOnStartup}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        <c:NavMenuOverlay x:Name="NavOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
